{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist-test"
  },
  "include": [
    "src/types/**/*.ts",
    "src/services/**/*.ts",
    "src/test/**/*.ts"
  ]
}
