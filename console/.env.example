# Chế độ xác thực của Web Console:
# - mock: Chế độ giả lập Cognito tại trình duyệt (mặc định để chạy độc lập và kiểm thử các luồng Q1)
# - cognito: Chế độ kết nối Amazon Cognito User Pool & API Gateway thật (sử dụng các biến bên dưới)
VITE_AUTH_MODE=mock

# Các biến cấu hình cho bước nối Amazon Cognito User Pool & REST API Gateway thật (Hạng mục 2.9 tiếp theo):
VITE_AWS_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_API_BASE_URL=http://localhost:3000

# Địa chỉ gốc của đường dẫn bản dịch (PUBLIC_BASE_URL của proxy, ví dụ https://d1abc.cloudfront.net) – màn Website (4.6)
VITE_PUBLIC_BASE_URL=
