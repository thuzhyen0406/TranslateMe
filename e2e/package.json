{
  "name": "translateme-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Hạ tầng và bộ kiểm thử E2E tuần 5 (TV1)",
  "engines": { "node": ">=20" },
  "scripts": {
    "test:isolation": "node --require ts-node/register/transpile-only --test tests/isolation.test.ts",
    "test:limits": "node --require ts-node/register/transpile-only --test tests/limits.test.ts",
    "test:ssrf": "node --require ts-node/register/transpile-only --test tests/ssrf.test.ts",
    "test:demo": "node --require ts-node/register/transpile-only --test tests/demo-seed.test.ts tests/siteVerification.test.ts tests/seed-preflight.test.ts",
    "test:helpers": "node --require ts-node/register/transpile-only --test tests/helpers.test.ts",
    "test:evidence": "node --require ts-node/register/transpile-only --test tests/aggregate-evidence.test.ts",
    "test:gate": "npm run typecheck && npm run test:helpers && npm run test:evidence && npm run test:isolation && npm run test:ssrf",
    "test:all": "node --require ts-node/register/transpile-only --test --test-concurrency=1 tests/helpers.test.ts tests/aggregate-evidence.test.ts tests/isolation.test.ts tests/ssrf.test.ts tests/limits.test.ts tests/demo-seed.test.ts tests/siteVerification.test.ts tests/seed-preflight.test.ts tests/sample-sites.test.ts tests/visitor-scripts.test.ts tests/deploy.test.ts tests/infra-stacks.test.ts",
    "selftest": "ts-node --transpile-only scripts/selftest.ts",
    "demo:preflight": "ts-node --transpile-only demo/preflight.ts",
    "demo:deploy": "ts-node --transpile-only demo/deploy.ts",
    "demo:seed": "ts-node --transpile-only demo/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "evidence": "ts-node --transpile-only tools/aggregate-evidence.ts",
    "sites:build": "ts-node --transpile-only tools/build-sites.ts",
    "demo:proxy-check": "ts-node --transpile-only demo/proxyCheck.ts",
    "demo:latency": "ts-node --transpile-only demo/latency.ts",
    "demo:kb8": "ts-node --transpile-only demo/kb8.ts",
    "rehearsal:proxy": "node --require ts-node/register/transpile-only scripts/proxy-rehearsal.cjs",
    "test:sites": "node --require ts-node/register/transpile-only --test tests/sample-sites.test.ts tests/visitor-scripts.test.ts",
    "test:infra": "node --require ts-node/register/transpile-only --test tests/deploy.test.ts tests/infra-stacks.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
