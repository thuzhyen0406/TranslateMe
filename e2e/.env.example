# Sao chép thành .env.<stage> rồi nạp vào shell (ví dụ: set -a; . ./.env.dev; set +a)
TM_STAGE=dev
TM_ACCOUNT=123456789012
TM_REGION=<region-cua-nhom>          # PHẢI giống Region đã chốt cho cả nhóm
TM_API_BASE=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
TM_PUBLIC_BASE=https://<id>.cloudfront.net
TM_CONSOLE_CLIENT_ID=<app-client-id-console>
TM_PLATFORM_CLIENT_ID=<app-client-id-platform>
TM_CONSOLE_USER_POOL_ID=<user-pool-id-console>
TM_PLATFORM_USER_POOL_ID=<user-pool-id-platform>
TM_PLATFORM_GROUP=PlatformAdmins
TM_AUTH_SCHEME=                       # để trống = gửi nguyên token; đặt "Bearer " nếu authorizer yêu cầu
TM_PLAN_BASIC=<usage-plan-id-basic>
TM_API_ID=<rest-api-id>
TM_API_STAGE=<stage-name>
TM_STACK_PREFIX=translateme
TM_TEMPLATE_DIR=../infra
# Chỉ đặt 1 trên dev hoặc demo: cho phép test khóa tenant và đổi cấu hình nền tảng
TM_ALLOW_MUTATION=0
# Số request đồng thời cho L1. Giữ vừa phải để không làm cạn Lambda concurrency của account.
TM_FLOOD_N=30
# Chỉ đặt 1 khi endpoint tùy chọn đã được tích hợp trên môi trường đang kiểm thử.
TM_E2E_HAS_CONSOLE_ME=0
TM_E2E_HAS_CONSOLE_USAGE=0
TM_E2E_HAS_CONSOLE_BATCH_RESULT=0
TM_E2E_HAS_PLATFORM_TENANT_DETAIL=0
TM_E2E_HAS_PLATFORM_TENANT_LIST=0
TM_E2E_HAS_PLATFORM_CONFIG=0
# Fixture do TV4 cung cấp cho 2 đích SSRF cần máy chủ thật (bỏ trống thì test đánh dấu SKIP)
TM_SSRF_REBIND_URL=
TM_SSRF_REDIRECT_URL=
