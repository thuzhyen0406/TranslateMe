{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@aws-sdk/client-translate": ["./node_modules/@aws-sdk/client-translate/dist-types/index.d.ts"]
    },
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "../..",
    "outDir": "dist"
  },
  "include": [
    "auth/**/*.ts",
    "console/**/*.ts",
    "sites/**/*.ts",
    "glossary/**/*.ts",
    "batch/**/*.ts",
    "keys/**/*.ts",
    "review/**/*.ts",
    "console/**/*.ts",
    "translate/**/*.ts",
    "prewarm/**/*.ts",
    "platform/**/*.ts",
    "../../libs/common/roles.ts",
    "../../libs/common/types.ts",
    "../../libs/common/db.ts",
    "../../libs/common/api-key-transaction.ts",
    "../../libs/common/tenant.ts",
    "../../libs/common/invalidation.ts",
    "../../libs/common/glossary.ts",
    "../../libs/common/markers.ts",
    "../../libs/common/seg.ts",
    "../../libs/common/tm.ts",
    "../../libs/common/jobs.ts",
    "../../libs/common/text-utils.ts",
    "../../libs/common/parsers.ts",
    "../../libs/common/markers.ts",
    "../../libs/common/extract.ts",
    "../../libs/common/rebuild.ts",
    "../../libs/common/htmlDom.ts",
    "../../libs/common/tenantAws.ts",
    "../../libs/common/usage/usage.ts",
    "../../tests/unit/cache_invalidation.test.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
