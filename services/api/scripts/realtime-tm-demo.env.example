# Copy to a local, untracked env file and fill values for the demo API key and clean tenant.
API_BASE_URL=https://example.execute-api.us-east-1.amazonaws.com/dev
API_KEY=replace-with-api-gateway-key-value
API_KEY_ID=replace-with-api-gateway-key-id
TENANT_ID=replace-with-clean-tenant-id
TABLE_NAME=TranslateMe
AWS_REGION=us-east-1

# MAP_MAX_CONCURRENCY limits simultaneous HTTP requests in the harness.
# TRANSLATE_CONCURRENCY limits parallel TranslateText calls inside each API request.
MAP_MAX_CONCURRENCY=4
TRANSLATE_CONCURRENCY=4
